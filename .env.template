# Copy to .env and fill in. .env is gitignored, never commit it.

# Oscar host, scheme included, no trailing slash. Dev tenant below.
OSCAR_HOST=https://medozai-dev.kai-oscar.com

# Deployment-specific context path. Probe it before signing anything:
#   /oscar/ws/services  -> 401 + WWW-Authenticate: OAuth  = correct
#   /ws/services        -> 403 (Cloudflare, never reached Oscar)
#   /kaiemr/ws/services -> 404 (that prefix is the FHIR module)
OSCAR_CONTEXT_PATH=/oscar

# From the Oscar admin UI client registration (client name: RASMI).
OSCAR_CONSUMER_KEY=
OSCAR_CONSUMER_SECRET=

# Must match the callback registered on that client, exactly.
OSCAR_CALLBACK_URL=http://localhost:3000/oauth1/callback

# Where the access token is persisted. Gitignored. Delete to force re-auth.
OSCAR_TOKEN_FILE=.tokens/oscar_token.json
